  <Version>0.1.1</Version><LangVersion>latest</LangVersion><Deterministic>true</Deterministic>
  <GameManagedDir Condition="'$(GameManagedDir)'==''">PLEASE_SET_GameManagedDir</GameManagedDir>
 </PropertyGroup>
 <ItemGroup>
  <Compile Remove="tests/**/*.cs" />
  <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
  <Reference Include="MonoMod.RuntimeDetour"><HintPath>$(GameManagedDir)/MonoMod.RuntimeDetour.dll</HintPath><Private>false</Private></Reference>
  <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
 </ItemGroup>
</Project>
